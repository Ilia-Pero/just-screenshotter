{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Just Screenshotter",
  "mainBinaryName": "just-screenshotter",
  "version": "0.1.0",
  "identifier": "io.github.ilia-pero.just-screenshotter",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "npm run bundle",
    "beforeDevCommand": "npm run bundle"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb"
    ],
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Ilia-Pero",
    "license": "MIT",
    "homepage": "https://github.com/Ilia-Pero/just-screenshotter",
    "shortDescription": "A screenshot tool with zero idle load",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Russian",
          "SpanishInternational",
          "Greek",
          "Hebrew",
          "SimpChinese",
          "Japanese",
          "Korean",
          "Serbian",
          "French",
          "German",
          "Italian"
        ],
        "customLanguageFiles": {
          "Greek": "installer/Greek.nsh",
          "Serbian": "installer/Serbian.nsh"
        },
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-tools",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-pipewire"
        ]
      }
    }
  }
}
